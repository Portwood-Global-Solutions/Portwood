<?xml version='1.0' encoding='UTF-8' ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <actionCalls>
        <name>Merge_Text</name>
        <label>Merge PDFs from Text</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <actionName>DocGenPdfMergeFlowAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Merge_Error</targetReference>
        </faultConnector>
        <inputParameters>
            <name>contentVersionIdsText</name>
            <value>
                <elementReference>idsText</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>documentTitle</name>
            <value>
                <elementReference>documentTitle</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>padOddDocuments</name>
            <value>
                <elementReference>padDocuments</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>mergedContentVersionId</assignToReference>
            <name>contentVersionId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>mergedContentDocumentId</assignToReference>
            <name>contentDocumentId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>mergeSuccess</assignToReference>
            <name>success</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>errorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Merge_Collection</name>
        <label>Merge PDFs from Text Collection</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <actionName>DocGenPdfMergeFlowAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Merge_Error</targetReference>
        </faultConnector>
        <inputParameters>
            <name>contentVersionIds</name>
            <value>
                <elementReference>sourceIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>documentTitle</name>
            <value>
                <elementReference>documentTitle</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>padOddDocuments</name>
            <value>
                <elementReference>padDocuments</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>mergedContentVersionId</assignToReference>
            <name>contentVersionId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>mergedContentDocumentId</assignToReference>
            <name>contentDocumentId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>mergeSuccess</assignToReference>
            <name>success</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>errorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>
    <assignments>
        <name>Build_Collection</name>
        <label>Build a Text collection</label>
        <locationX>440</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Merge_Collection</targetReference>
        </connector>
        <assignmentItems>
            <assignToReference>sourceIds</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>emptyIds</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sourceIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>firstId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>sourceIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>secondId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <choices>
        <name>Text_Choice</name>
        <choiceText>Single Text (IDs separated by commas)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Text</stringValue>
        </value>
    </choices>
    <choices>
        <name>Collection_Choice</name>
        <choiceText>Text Collection (two separate ID values)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Collection</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Choose_Input</name>
        <label>Which input format?</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Merge_Text</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Text</defaultConnectorLabel>
        <rules>
            <name>Use_Collection</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Collection</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Collection</targetReference>
            </connector>
            <label>Collection</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Result</name>
        <label>PDF created?</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <defaultConnector>
            <targetReference>Merge_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Error</defaultConnectorLabel>
        <rules>
            <name>Merge_Succeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>mergeSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Merged_PDF</targetReference>
            </connector>
            <label>Success</label>
        </rules>
    </decisions>
    <description
    >Interactive demo of Portwood: Merge PDFs. Run scripts/demo/pdf-merge/seed-demo.apex first to create the sample Files. Choose Text or Text Collection, merge, and open the result.</description>
    <formulas>
        <name>DefaultIdsText</name>
        <dataType>String</dataType>
        <expression>{!Get_Welcome.Id} &amp; ", " &amp; {!Get_Brief.Id}</expression>
    </formulas>
    <formulas>
        <name>MergedFileUrl</name>
        <dataType>String</dataType>
        <expression
        >SUBSTITUTE(SUBSTITUTE(LEFT({!$Api.Partner_Server_URL_620}, FIND("/services", {!$Api.Partner_Server_URL_620}) - 1), "--c.", "."), ".vf.force.com", ".my.salesforce.com") &amp; "/lightning/r/ContentDocument/" &amp; {!mergedContentDocumentId} &amp; "/view"</expression>
    </formulas>
    <interviewLabel>Portwood PDF Merge Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Portwood: PDF Merge Demo</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Welcome</name>
        <label>Find welcome letter</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Brief</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Title</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Portwood Merge Demo - Welcome</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsLatest</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentVersion</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Brief</name>
        <label>Find project brief</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Configure_Merge</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Title</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Portwood Merge Demo - Project Brief</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsLatest</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentVersion</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Configure_Merge</name>
        <label>Merge PDFs in Flow</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Choose_Input</targetReference>
        </connector>
        <fields>
            <name>Demo_Intro</name>
            <fieldText
            >&lt;h2&gt;Merge two PDFs. Get one complete packet.&lt;/h2&gt;&lt;p&gt;Try the ready-to-use samples, or replace their ContentVersion IDs with your own.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;1. Welcome letter&lt;/strong&gt; - 1 page&lt;br/&gt;&lt;strong&gt;2. Project brief &amp;amp; delivery checklist&lt;/strong&gt; - 2 pages&lt;/p&gt;&lt;p&gt;The sample result has three pages, in that order. Each sample page is labeled so you can check it.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>inputMode</name>
            <choiceReferences>Text_Choice</choiceReferences>
            <choiceReferences>Collection_Choice</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>Text</stringValue>
            </defaultValue>
            <fieldText>ID input format</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>idsText</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>DefaultIdsText</elementReference>
            </defaultValue>
            <fieldText>ContentVersion IDs (comma-separated Text)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>inputMode</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Text</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>firstId</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Get_Welcome.Id</elementReference>
            </defaultValue>
            <fieldText>First ContentVersion ID</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>inputMode</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Collection</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>secondId</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Get_Brief.Id</elementReference>
            </defaultValue>
            <fieldText>Second ContentVersion ID</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>inputMode</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Collection</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>documentTitle</name>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>Portwood - Welcome Packet</stringValue>
            </defaultValue>
            <fieldText>New PDF name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>padDocuments</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>false</booleanValue>
            </defaultValue>
            <fieldText>Add blank pages for double-sided printing</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Merge PDFs</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Merged_PDF</name>
        <label>Your PDF is ready</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Message</name>
            <fieldText
            >&lt;h2&gt;Your PDF is ready.&lt;/h2&gt;&lt;p&gt;The documents have been merged and saved as a new Salesforce File.&lt;/p&gt;&lt;p&gt;&lt;a href="{!MergedFileUrl}" target="_blank"&gt;&lt;strong&gt;Open merged PDF&lt;/strong&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;For the sample files, look for the welcome letter first, then the project brief and delivery checklist.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;ContentVersion ID:&lt;/strong&gt; {!mergedContentVersionId}&lt;br/&gt;&lt;strong&gt;ContentDocument ID:&lt;/strong&gt; {!mergedContentDocumentId}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Merge_Error</name>
        <label>PDF merge needs attention</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText
            >&lt;h2&gt;The PDF could not be merged.&lt;/h2&gt;&lt;p&gt;{!errorMessage}&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Go back to check the IDs and try again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Welcome</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>sourceIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>emptyIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>mergedContentVersionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>mergedContentDocumentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>mergeSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
